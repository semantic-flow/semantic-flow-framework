{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:04-ontology-integrated",
  "dcterms:title": "Fantasy Rules Sidecar 04 ontology integrated",
  "dcterms:description": "Checks the transition from the woven docs-rooted sidecar mesh to the first ontology payload integration.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#integrate-ontology",
      "dcterms:title": "Integrate the ontology artifact into the docs-rooted sidecar mesh",
      "dcterms:description": "Runs integrate from the fixture workspace root with mesh root docs. The ontology source remains under ontology/, the mesh config gains a constrained ../ontology/ workingLocalRelativePath grant, and the ontology Knop support surface is created under docs/ontology/_knop/.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "integrate",
      "fromRef": "03-sidecar-mesh-created-woven",
      "toRef": "04-ontology-integrated",
      "hasFileExpectation": [
        {
          "id": "#gitignore",
          "type": "FileExpectation",
          "path": ".gitignore",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#nojekyll",
          "type": "FileExpectation",
          "path": "docs/.nojekyll",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#mesh-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/index.html",
          "changeType": "absent"
        },
        {
          "id": "#ontology-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config a <https://semantic-flow.github.io/ontology/config/MeshConfig> ; <https://semantic-flow.github.io/ontology/config/workspaceRootRelativeToMeshRoot> \"../\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathAccessRule> ?rule . ?rule a <https://semantic-flow.github.io/ontology/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/ontology/config/hasLocalPathBase> <https://semantic-flow.github.io/ontology/config/meshRootPathBase> ; <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../ontology/\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/ontology/config/workingLocalRelativePathLocatorKind> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../shacl/\" . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/semantic-flow-ontology/hasKnop> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> a <https://semantic-flow.github.io/semantic-flow-ontology/PayloadArtifact>, <https://semantic-flow.github.io/semantic-flow-ontology/DigitalArtifact>, <https://semantic-flow.github.io/semantic-flow-ontology/RdfDocument> ; <https://semantic-flow.github.io/semantic-flow-ontology/workingLocalRelativePath> \"../ontology/fantasy-rules-ontology.ttl\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> <https://semantic-flow.github.io/semantic-flow-ontology/hasWorkingLocatedFile> ?file . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop> a <https://semantic-flow.github.io/semantic-flow-ontology/Knop> ; <https://semantic-flow.github.io/semantic-flow-ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/_inventory/inventory.ttl> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ontology-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop> <https://semantic-flow.github.io/semantic-flow-ontology/hasPayloadArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> <https://semantic-flow.github.io/semantic-flow-ontology/workingLocalRelativePath> \"../ontology/fantasy-rules-ontology.ttl\" . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
