          "path": "docs/ontology/CharacterShape/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-shape-references-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/CharacterShape/_knop/_references/references.ttl",
          "changeType": "added",
