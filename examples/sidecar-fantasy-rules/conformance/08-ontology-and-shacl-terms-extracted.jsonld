          "path": "docs/ontology/Character/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-references-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/Character/_knop/_references/references.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#player-character-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/PlayerCharacter/_knop/_meta/meta.ttl",
          "changeType": "added",
