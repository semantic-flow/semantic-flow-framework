  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:08-ontology-and-shacl-terms-extracted",
  "dcterms:title": "Fantasy Rules Sidecar 08 ontology and SHACL terms extracted",
  "dcterms:description": "Checks the non-woven extraction of selected slash-IRI ontology and SHACL terms into Knop-managed current surfaces.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#extract-ontology-and-shacl-terms",
      "dcterms:title": "Extract selected ontology and SHACL terms into Knop-managed resources",
      "dcterms:description": "Runs extract from the fixture workspace root with mesh root docs. The selected term Knops get metadata, inventory, and ReferenceCatalog support artifacts with Supplemental links pinned to the woven ontology or SHACL state that justified the extraction. The authored source bytes, mesh config, and generated pages remain unchanged until the following weave step.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "extract",
      "fromRef": "07-shacl-integrated-woven",
      "toRef": "08-ontology-and-shacl-terms-extracted",
      "targetDesignatorPaths": [
        "ontology/AbilityScore",
        "ontology/Alignment",
        "ontology/Character",
        "ontology/PlayerCharacter",
        "ontology/CharacterShape"
      ],
      "sourceDesignatorPaths": [
        "ontology",
        "ontology",
        "ontology",
        "ontology",
        "shacl"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-references-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_references/references.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#alignment-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/Alignment/_knop/_meta/meta.ttl",
          "changeType": "added",
