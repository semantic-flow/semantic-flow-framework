  "dcterms:title": "Fantasy Rules Sidecar 09 ontology and SHACL terms extracted woven",
  "dcterms:description": "Checks weaving selected extracted ontology and SHACL term Knops into histories and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-ontology-and-shacl-terms",
      "dcterms:title": "Weave selected extracted ontology and SHACL terms",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs and explicit targets for the selected extracted term designator paths. The term support artifacts receive first histories, the mesh inventory records the generated pages, and source RDF remains available through inventory-carried ExtractionSource bindings.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "08-ontology-and-shacl-terms-extracted",
      "toRef": "09-ontology-and-shacl-terms-extracted-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs",
            "--target",
            "designatorPath=ontology/AbilityScore",
            "--target",
            "designatorPath=ontology/Alignment",
            "--target",
            "designatorPath=ontology/Character",
            "--target",
            "designatorPath=ontology/PlayerCharacter",
            "--target",
            "designatorPath=ontology/CharacterShape"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPaths": [
        "ontology/AbilityScore",
        "ontology/Alignment",
        "ontology/Character",
        "ontology/PlayerCharacter",
        "ontology/CharacterShape"
      ],
