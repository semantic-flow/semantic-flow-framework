  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:09-ontology-and-shacl-terms-extracted-woven",
  "dcterms:title": "Fantasy Rules Sidecar 09 ontology and SHACL terms extracted woven",
  "dcterms:description": "Checks weaving selected extracted ontology and SHACL term Knops into histories and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-ontology-and-shacl-terms",
      "dcterms:title": "Weave selected extracted ontology and SHACL terms",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs and explicit targets for the selected extracted term designator paths. The term support artifacts receive first histories, the mesh inventory advances once per term, generated ResourcePages are present, and source RDF remains available through the woven ontology and SHACL snapshots pinned by inventory-carried ExtractionSource bindings.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "08-ontology-and-shacl-terms-extracted",
      "toRef": "09-ontology-and-shacl-terms-extracted-woven",
      "targetDesignatorPaths": [
        "ontology/AbilityScore",
        "ontology/Alignment",
        "ontology/Character",
        "ontology/PlayerCharacter",
        "ontology/CharacterShape"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_history001/_s0001/fantasy-rules-ontology-ttl/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/shacl/_history001/_s0001/fantasy-rules-shacl-ttl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state4-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0004/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state5-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0005/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state6-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0006/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state7-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0007/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state8-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0008/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-meta-history-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_meta/_history001/_s0001/meta-ttl/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/_inventory/_history001/_s0001/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-shape-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/CharacterShape/_knop/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-shape-meta-history-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/CharacterShape/_knop/_meta/_history001/_s0001/meta-ttl/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-shape-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/CharacterShape/_knop/_inventory/_history001/_s0001/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-score-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/index.html",
          "changeType": "added"
        },
        {
          "id": "#alignment-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/Alignment/index.html",
          "changeType": "added"
        },
        {
          "id": "#character-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/Character/index.html",
          "changeType": "added"
        },
        {
          "id": "#player-character-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/PlayerCharacter/index.html",
          "changeType": "added"
        },
        {
          "id": "#character-shape-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/CharacterShape/index.html",
          "changeType": "added"
        },
        {
          "id": "#ability-score-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScore/_knop/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config a <https://semantic-flow.github.io/ontology/config/MeshConfig> ; <https://semantic-flow.github.io/ontology/config/workspaceRootRelativeToMeshRoot> \"../\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathAccessRule> ?ontologyRule, ?shaclRule . ?ontologyRule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../ontology/\" . ?shaclRule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../shacl/\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory/_history001> <https://semantic-flow.github.io/semantic-flow-ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory/_history001/_s0008> ; <https://semantic-flow.github.io/semantic-flow-ontology/nextStateOrdinal> \"9\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ability-score-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ability-score-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore/_knop> <https://semantic-flow.github.io/ontology/core/hasExtractionSource> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore/_knop/_inventory#extraction-source> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore/_knop/_inventory#extraction-source> a <https://semantic-flow.github.io/ontology/core/ExtractionSource> ; <https://semantic-flow.github.io/ontology/core/hasTargetArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> ; <https://semantic-flow.github.io/ontology/core/hasRequestedTargetState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001/_s0001> ; <https://semantic-flow.github.io/ontology/core/hasArtifactResolutionMode> <https://semantic-flow.github.io/ontology/core/ArtifactResolutionMode/Pinned> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#character-shape-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#character-shape-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop> <https://semantic-flow.github.io/ontology/core/hasExtractionSource> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop/_inventory#extraction-source> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop/_inventory#extraction-source> a <https://semantic-flow.github.io/ontology/core/ExtractionSource> ; <https://semantic-flow.github.io/ontology/core/hasTargetArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> ; <https://semantic-flow.github.io/ontology/core/hasRequestedTargetState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_history001/_s0001> ; <https://semantic-flow.github.io/ontology/core/hasArtifactResolutionMode> <https://semantic-flow.github.io/ontology/core/ArtifactResolutionMode/Pinned> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape/_knop> <https://semantic-flow.github.io/semantic-flow-ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
