{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:10-root-knop",
  "dcterms:title": "Fantasy Rules Sidecar 10 root Knop",
  "dcterms:description": "Checks the non-woven creation of the docs-rooted sidecar repository root Knop and examples collection Knop.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#create-root-and-examples-knops",
      "dcterms:title": "Create repository root and examples collection Knops",
      "dcterms:description": "Runs two knop create operations from the fixture repository root against the docs mesh: first for /, then for examples. The current support artifacts and mesh inventory are updated, generated ResourcePages and histories are deferred, and no examples source path grant is added before a concrete examples payload is integrated.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "knop.create",
      "fromRef": "09-ontology-and-shacl-terms-extracted-woven",
      "toRef": "10-root-knop",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandSequence": [
          {
            "type": "CommandInvocation",
            "executable": "weave",
            "argv": [
              "knop",
              "create",
              "/",
              "--mesh-root",
              "docs"
            ],
            "workingDirectory": "workspace",
            "promptPolicy": "nonInteractive",
            "expectedExitCode": 0,
            "expectsOperationalLogs": true,
            "expectsAuditLogs": true
          },
          {
            "type": "CommandInvocation",
            "executable": "weave",
            "argv": [
              "knop",
              "create",
              "examples",
              "--mesh-root",
              "docs"
            ],
            "workingDirectory": "workspace",
            "promptPolicy": "nonInteractive",
            "expectedExitCode": 0,
            "expectsOperationalLogs": true,
            "expectsAuditLogs": true
          }
        ]
      },
      "targetDesignatorPaths": [
        "/",
        "examples"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-page-html",
          "type": "FileExpectation",
          "path": "docs/index.html",
          "changeType": "absent"
        },
        {
          "id": "#root-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/_knop/index.html",
          "changeType": "absent"
        },
        {
          "id": "#examples-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/index.html",
          "changeType": "absent"
        },
        {
          "id": "#examples-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/index.html",
          "changeType": "absent"
        },
        {
          "id": "#root-knop-inventory-history-page-html",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/_history001/index.html",
          "changeType": "absent"
        },
        {
          "id": "#examples-knop-inventory-history-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/_history001/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config a <https://semantic-flow.github.io/sflo/config/MeshConfig> ; <https://semantic-flow.github.io/sflo/config/workspaceRootRelativeToMeshRoot> \"../\" ; <https://semantic-flow.github.io/sflo/config/hasLocalPathAccessRule> ?ontologyRule, ?shaclRule . ?ontologyRule <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../ontology/\" . ?shaclRule <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../shacl/\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop> a <https://semantic-flow.github.io/sflo/ontology/Knop> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/inventory.ttl> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop> a <https://semantic-flow.github.io/sflo/ontology/Knop> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/inventory.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> ?page . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> ?page . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#root-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#root-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop> <https://semantic-flow.github.io/sflo/ontology/hasKnopMetadata> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta> ; <https://semantic-flow.github.io/sflo/ontology/hasKnopInventory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/inventory.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#examples-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#examples-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop> <https://semantic-flow.github.io/sflo/ontology/hasKnopMetadata> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta> ; <https://semantic-flow.github.io/sflo/ontology/hasKnopInventory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/inventory.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
}
