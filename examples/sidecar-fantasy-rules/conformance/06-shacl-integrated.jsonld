{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:06-shacl-integrated",
  "dcterms:title": "Fantasy Rules Sidecar 06 SHACL integrated",
  "dcterms:description": "Checks the transition from the woven ontology sidecar mesh to the first SHACL payload integration.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#integrate-shacl",
      "dcterms:title": "Integrate the SHACL artifact into the docs-rooted sidecar mesh",
      "dcterms:description": "Runs integrate from the fixture workspace root with mesh root docs. The SHACL source remains under shacl/, the mesh config gains a constrained ../shacl/ workingLocalRelativePath grant, and the SHACL Knop support surface is created under docs/shacl/_knop/.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "integrate",
      "fromRef": "05-ontology-integrated-woven",
      "toRef": "06-shacl-integrated",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "integrate",
            "./shacl/fantasy-rules-shacl.ttl",
            "shacl",
            "--mesh-root",
            "docs",
            "--grant-source-directory",
            "shacl"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "hasFileExpectation": [
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-knop-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/shacl/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/shacl/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/index.html",
          "changeType": "absent"
        },
        {
          "id": "#shacl-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/_knop/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config a <https://semantic-flow.github.io/ontology/config/MeshConfig> ; <https://semantic-flow.github.io/ontology/config/workspaceRootRelativeToMeshRoot> \"../\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathAccessRule> ?ontologyRule, ?shaclRule . ?ontologyRule a <https://semantic-flow.github.io/ontology/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/ontology/config/hasLocalPathBase> <https://semantic-flow.github.io/ontology/config/localPathBase_meshRoot> ; <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../ontology/\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/ontology/config/localPathLocatorKind_workingLocalRelativePath> . ?shaclRule a <https://semantic-flow.github.io/ontology/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/ontology/config/hasLocalPathBase> <https://semantic-flow.github.io/ontology/config/localPathBase_meshRoot> ; <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../shacl/\" ; <https://semantic-flow.github.io/ontology/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/ontology/config/localPathLocatorKind_workingLocalRelativePath> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> ; <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../shacl/fantasy-rules-shacl.ttl\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> ?file . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_knop> a <https://semantic-flow.github.io/sflo/ontology/Knop> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingKnopInventoryFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_knop/_inventory/inventory.ttl> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#shacl-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#shacl-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_knop> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../shacl/fantasy-rules-shacl.ttl\" . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
