{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:13-gunaar-example-dataset-woven",
  "dcterms:title": "Fantasy Rules Sidecar 13 Gunaar example dataset woven",
  "dcterms:description": "Checks weaving the Gunaar example dataset into history and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-gunaar-example-dataset",
      "dcterms:title": "Weave the Gunaar example dataset artifact",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs and an explicit target for examples/gunaar. The dataset source remains under examples/, historical bytes are copied into the public docs mesh, and generated ResourcePages are present for the dataset, support artifacts, history, state, manifestation, and located Turtle file.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "12-gunaar-example-dataset",
      "toRef": "13-gunaar-example-dataset-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs",
            "--target",
            "designatorPath=examples/gunaar"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPath": "examples/gunaar",
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_history001/_s0001/ttl/gunaar.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-history-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_history001/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-state-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_history001/_s0001/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-manifestation-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_history001/_s0001/ttl/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#gunaar-payload-history-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#gunaar-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/index.html> ; <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001> ; <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001/_s0001> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001/_s0001> <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001/_s0001/ttl/gunaar.ttl> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001/_s0001/ttl> <https://semantic-flow.github.io/sflo/ontology/hasLocatedFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_history001/_s0001/ttl/gunaar.ttl> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#gunaar-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#gunaar-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_knop> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_knop/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../examples/gunaar.ttl\" . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
