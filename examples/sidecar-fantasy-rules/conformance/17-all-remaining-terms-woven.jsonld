        {
          "id": "#ontology-release-term-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/releases/v0.0.2/index.html",
          "changeType": "updated"
        },
        {
          "id": "#shacl-release-term-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/releases/v0.0.2/index.html",
          "changeType": "updated"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScoreShape> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScoreShape/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/ability-score/strength> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/ability-score/strength/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ability-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ability-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability/_knop> <https://semantic-flow.github.io/sflo/ontology/hasExtractionSource> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability/_knop/_sources#extraction-source> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability/_knop/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ability-sources-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ability-sources-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Ability/_knop/_sources#extraction-source> a <https://semantic-flow.github.io/sflo/ontology/ExtractionSource> ; <https://semantic-flow.github.io/sflo/ontology/hasTargetArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> ; <https://semantic-flow.github.io/sflo/ontology/hasRequestedTargetState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> ; <https://semantic-flow.github.io/sflo/ontology/hasObservedSourceState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> ; <https://semantic-flow.github.io/sflo/ontology/hasObservedSourceManifestation> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl> ; <https://semantic-flow.github.io/sflo/ontology/hasObservedSourceLocatedFile> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl> ; <https://semantic-flow.github.io/sflo/ontology/observedSourceDigest> \"sha256:c8fe09dcea187f153c3f61a53abdf66aa0704208a02cf66cf8017b0d40383acf\" . }",
