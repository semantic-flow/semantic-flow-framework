          "type": "FileExpectation",
          "path": "docs/ontology/Ability/index.html",
          "changeType": "added"
        },
        {
          "id": "#ability-score-shape-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/AbilityScoreShape/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-strength-page-html",
          "type": "FileExpectation",
