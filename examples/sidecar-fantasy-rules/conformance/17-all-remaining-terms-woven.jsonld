  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:17-all-remaining-terms-woven",
  "dcterms:title": "Fantasy Rules Sidecar 17 all remaining terms woven",
  "dcterms:description": "Checks weaving the remaining extracted ontology, SHACL, and example terms so every mesh-scoped source IRI has a ResourcePage.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-all-remaining-terms",
      "dcterms:title": "Weave all remaining extracted terms",
      "dcterms:description": "Runs a broad weave against the docs-rooted mesh. The version phase skips already-settled current-only support Knops, versions the remaining extracted term Knops, and the generate phase refreshes ResourcePages across the mesh so all mesh-scoped IRIs from the ontology, SHACL, and Gunaar example sources are page-backed.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "16-all-remaining-terms-extracted",
      "toRef": "17-all-remaining-terms-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPaths": [
        "examples/gunaar/ability-score/charisma",
        "examples/gunaar/ability-score/constitution",
        "examples/gunaar/ability-score/dexterity",
        "examples/gunaar/ability-score/intelligence",
        "examples/gunaar/ability-score/strength",
        "examples/gunaar/ability-score/wisdom",
        "ontology/Ability",
        "ontology/AbilityScoreShape",
        "ontology/Alignment/chaoticEvil",
        "ontology/Alignment/chaoticGood",
        "ontology/Alignment/chaoticNeutral",
        "ontology/Alignment/lawfulEvil",
        "ontology/Alignment/lawfulGood",
        "ontology/Alignment/lawfulNeutral",
        "ontology/Alignment/neutral",
        "ontology/Alignment/neutralEvil",
        "ontology/Alignment/neutralGood",
        "ontology/Alignment/unaligned",
        "ontology/AlignmentHistory",
        "ontology/BarbarianPrimaryAbilityChoice",
        "ontology/BardPrimaryAbilityChoice",
        "ontology/CharacterClass",
        "ontology/CharacterPrimaryAbilityByClassShape",
        "ontology/ClericPrimaryAbilityChoice",
        "ontology/DruidPrimaryAbilityChoice",
        "ontology/FighterPrimaryAbilityChoice",
        "ontology/MonkPrimaryAbilityChoice",
        "ontology/PaladinPrimaryAbilityChoice",
        "ontology/RangerPrimaryAbilityChoice",
        "ontology/RoguePrimaryAbilityChoice",
        "ontology/SorcererPrimaryAbilityChoice",
        "ontology/WarlockPrimaryAbilityChoice",
        "ontology/WizardPrimaryAbilityChoice",
        "ontology/alignmentValue",
        "ontology/barbarian",
        "ontology/bard",
        "ontology/character",
        "ontology/charisma",
        "ontology/cleric",
        "ontology/constitution",
        "ontology/dexterity",
        "ontology/druid",
        "ontology/effectiveDateTime",
        "ontology/fighter",
        "ontology/forAbility",
        "ontology/hasAbilityScore",
        "ontology/hasAlignment",
        "ontology/hasCharacterClass",
        "ontology/intelligence",
        "ontology/level",
        "ontology/monk",
        "ontology/paladin",
        "ontology/primaryAbility",
        "ontology/ranger",
        "ontology/releases/v0.0.2",
        "ontology/rogue",
        "ontology/scoreValue",
        "ontology/sorcerer",
        "ontology/strength",
        "ontology/warlock",
        "ontology/wisdom",
        "ontology/wizard",
        "shacl/releases/v0.0.2"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
