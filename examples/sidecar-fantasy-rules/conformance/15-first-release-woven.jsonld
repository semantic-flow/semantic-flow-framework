{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:15-first-release-woven",
  "dcterms:title": "Fantasy Rules Sidecar 15 first release woven",
  "dcterms:description": "Checks weaving the first named ontology and SHACL release histories into the docs-rooted sidecar mesh.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-first-release",
      "dcterms:title": "Weave first named ontology and SHACL releases",
      "dcterms:description": "Runs targeted weave operations for ontology and shacl with payload history segment releases, state segment v0.0.2, and manifestation segment ttl. The prior ordinal histories remain present, the named release histories become current for their artifacts, and the release snapshots are byte-identical to the authored sources.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "14-first-release",
      "toRef": "15-first-release-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs",
            "--payload-history-segment",
            "releases",
            "--payload-state-segment",
            "v0.0.2",
            "--payload-manifestation-segment",
            "ttl",
            "--target",
            "designatorPath=ontology",
            "--target",
            "designatorPath=shacl"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPaths": [
        "ontology",
        "shacl"
      ],
      "payloadHistorySegment": "releases",
      "payloadStateSegment": "v0.0.2",
      "payloadManifestationSegment": "ttl",
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/shacl/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-release-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-release-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/shacl/releases/v0.0.2/ttl/fantasy-rules-shacl.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-history-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/releases/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-state-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/releases/v0.0.2/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-manifestation-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/releases/v0.0.2/ttl/index.html",
          "changeType": "added"
        },
        {
          "id": "#shacl-history-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/releases/index.html",
          "changeType": "added"
        },
        {
          "id": "#shacl-state-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/releases/v0.0.2/index.html",
          "changeType": "added"
        },
        {
          "id": "#shacl-manifestation-page-html",
          "type": "FileExpectation",
          "path": "docs/shacl/releases/v0.0.2/ttl/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#ontology-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases> ; <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases> ; <https://semantic-flow.github.io/sflo/ontology/nextHistoryOrdinal> \"2\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases> <https://semantic-flow.github.io/sflo/ontology/hasHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> ; <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/hasManifestation> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl> ; <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl> <https://semantic-flow.github.io/sflo/ontology/locatedFileForManifestation> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases> <https://semantic-flow.github.io/sflo/ontology/nextStateOrdinal> \"1\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases> <https://semantic-flow.github.io/sflo/ontology/historyOrdinal> ?ordinal . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/stateOrdinal> ?ordinal . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#shacl-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#shacl-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/_history001>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases> ; <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases> ; <https://semantic-flow.github.io/sflo/ontology/nextHistoryOrdinal> \"2\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases> <https://semantic-flow.github.io/sflo/ontology/hasHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2> ; <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/hasManifestation> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2/ttl> ; <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2/ttl/fantasy-rules-shacl.ttl> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2/ttl> <https://semantic-flow.github.io/sflo/ontology/locatedFileForManifestation> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2/ttl/fantasy-rules-shacl.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases> <https://semantic-flow.github.io/sflo/ontology/nextStateOrdinal> \"1\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases> <https://semantic-flow.github.io/sflo/ontology/historyOrdinal> ?ordinal . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl/releases/v0.0.2> <https://semantic-flow.github.io/sflo/ontology/stateOrdinal> ?ordinal . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
}
