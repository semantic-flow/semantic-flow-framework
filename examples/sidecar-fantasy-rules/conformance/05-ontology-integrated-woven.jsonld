{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:05-ontology-integrated-woven",
  "dcterms:title": "Fantasy Rules Sidecar 05 ontology integrated woven",
  "dcterms:description": "Checks the transition from the current ontology integration to its first woven ontology payload state and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-ontology",
      "dcterms:title": "Weave the ontology artifact into historical state and ResourcePages",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs. The ontology payload receives its first history, its current and historical ResourcePages are generated, and the ontology ResourcePage exposes raw Turtle bytes from the adjacent source file.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "04-ontology-integrated",
      "toRef": "05-ontology-integrated-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "hasFileExpectation": [
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-snapshot-ttl",
          "type": "FileExpectation",
          "path": "docs/ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-meta-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_meta/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-knop-inventory-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/_inventory/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-history-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_history001/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-state-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_history001/_s0001/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-manifestation-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_history001/_s0001/ttl/index.html",
          "changeType": "added"
        },
        {
          "id": "#ontology-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/ontology/_knop/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ontology-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001> ; <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../ontology/fantasy-rules-ontology.ttl\" ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001/_s0001> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001/_s0001> <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/_meta> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/_meta/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/_inventory> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/_knop/_inventory/index.html> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
