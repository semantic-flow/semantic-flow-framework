  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:03-sidecar-mesh-created-woven",
  "dcterms:title": "Fantasy Rules Sidecar 03 sidecar mesh created woven",
  "dcterms:description": "Checks the transition from a docs-rooted mesh-created sidecar to its first woven support histories and current ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-support-pages",
      "dcterms:title": "Weave support histories and current ResourcePages for the docs-rooted sidecar mesh",
      "dcterms:description": "Runs weave with mesh root docs. No domain Knops or payload artifacts are introduced; the mesh metadata, inventory, and config support artifacts receive first histories, the mesh inventory records current and historical support ResourcePages, and the HTML pages are rendered under docs/.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "02-sidecar-mesh-created",
      "toRef": "03-sidecar-mesh-created-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "hasFileExpectation": [
        {
          "id": "#gitignore",
          "type": "FileExpectation",
          "path": ".gitignore",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#ontology-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#nojekyll",
          "type": "FileExpectation",
          "path": "docs/.nojekyll",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#mesh-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-meta-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_meta/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-inventory-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-config-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-config-history-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/_history001/_s0001/ttl/config.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-history-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/_history001/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-config-state-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/_history001/_s0001/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-config-manifestation-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/_history001/_s0001/ttl/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_meta> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_meta/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config> <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/_history001> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/_history001/_s0001> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/_history001/_s0001> <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/_history001/_s0001/ttl/config.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/index.html> a <https://semantic-flow.github.io/sflo/ontology/ResourcePage>, <https://semantic-flow.github.io/sflo/ontology/LocatedFile> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/index.html> a <https://semantic-flow.github.io/sflo/ontology/ResourcePage>, <https://semantic-flow.github.io/sflo/ontology/LocatedFile> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?s a <https://semantic-flow.github.io/sflo/ontology/Knop> . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
