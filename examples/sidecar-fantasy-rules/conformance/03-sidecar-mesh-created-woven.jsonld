{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:03-sidecar-mesh-created-woven",
  "dcterms:title": "Fantasy Rules Sidecar 03 sidecar mesh created woven",
  "dcterms:description": "Checks the transition from a docs-rooted mesh-created sidecar to its first woven current support ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-support-pages",
      "dcterms:title": "Weave current support ResourcePages for the docs-rooted sidecar mesh",
      "dcterms:description": "Runs weave with mesh root docs. No domain Knops or payload artifacts are introduced; the mesh inventory records current support ResourcePages and the HTML pages are rendered under docs/.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "02-sidecar-mesh-created",
      "toRef": "03-sidecar-mesh-created-woven",
      "hasFileExpectation": [
        {
          "id": "#gitignore",
          "type": "FileExpectation",
          "path": ".gitignore",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#ontology-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#nojekyll",
          "type": "FileExpectation",
          "path": "docs/.nojekyll",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#mesh-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-meta-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_meta/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-inventory-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/index.html",
          "changeType": "added"
        },
        {
          "id": "#mesh-config-page-html",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_meta> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_meta/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_inventory/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/index.html> a <https://semantic-flow.github.io/semantic-flow-ontology/ResourcePage>, <https://semantic-flow.github.io/semantic-flow-ontology/LocatedFile> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh/_config/index.html> a <https://semantic-flow.github.io/semantic-flow-ontology/ResourcePage>, <https://semantic-flow.github.io/semantic-flow-ontology/LocatedFile> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?s a <https://semantic-flow.github.io/semantic-flow-ontology/Knop> . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
}
