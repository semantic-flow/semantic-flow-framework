{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:12-gunaar-example-dataset",
  "dcterms:title": "Fantasy Rules Sidecar 12 Gunaar example dataset",
  "dcterms:description": "Checks the non-woven integration of the Gunaar example dataset into the docs-rooted sidecar mesh.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#integrate-gunaar-example-dataset",
      "dcterms:title": "Integrate the Gunaar example dataset artifact",
      "dcterms:description": "Runs integrate from the fixture workspace root with mesh root docs. The Gunaar source remains under examples/, the mesh config gains a constrained ../examples/ workingLocalRelativePath grant, the dataset is introduced at public path examples/gunaar, and generated ResourcePages and histories are deferred to the following weave step.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "integrate",
      "fromRef": "11-root-knop-woven",
      "toRef": "12-gunaar-example-dataset",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "integrate",
            "./examples/gunaar.ttl",
            "examples/gunaar",
            "--mesh-root",
            "docs",
            "--grant-source-directory",
            "examples"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPath": "examples/gunaar",
      "sourcePath": "examples/gunaar.ttl",
      "meshRoot": "docs",
      "grantSourceDirectory": "examples",
      "hasFileExpectation": [
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-knop-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/index.html",
          "changeType": "absent"
        },
        {
          "id": "#gunaar-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/index.html",
          "changeType": "absent"
        },
        {
          "id": "#gunaar-history-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_history001/index.html",
          "changeType": "absent"
        },
        {
          "id": "#gunaar-knop-inventory-history-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/gunaar/_knop/_inventory/_history001/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config a <https://semantic-flow.github.io/sflo/config/MeshConfig> ; <https://semantic-flow.github.io/sflo/config/workspaceRootRelativeToMeshRoot> \"../\" ; <https://semantic-flow.github.io/sflo/config/hasLocalPathAccessRule> ?ontologyRule, ?shaclRule, ?examplesRule . ?ontologyRule a <https://semantic-flow.github.io/sflo/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/sflo/config/hasLocalPathBase> <https://semantic-flow.github.io/sflo/config/localPathBase_meshRoot> ; <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../ontology/\" ; <https://semantic-flow.github.io/sflo/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/sflo/config/localPathLocatorKind_workingLocalRelativePath> . ?shaclRule a <https://semantic-flow.github.io/sflo/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/sflo/config/hasLocalPathBase> <https://semantic-flow.github.io/sflo/config/localPathBase_meshRoot> ; <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../shacl/\" ; <https://semantic-flow.github.io/sflo/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/sflo/config/localPathLocatorKind_workingLocalRelativePath> . ?examplesRule a <https://semantic-flow.github.io/sflo/config/LocalPathAccessRule> ; <https://semantic-flow.github.io/sflo/config/hasLocalPathBase> <https://semantic-flow.github.io/sflo/config/localPathBase_meshRoot> ; <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../examples/\" ; <https://semantic-flow.github.io/sflo/config/hasLocalPathLocatorKind> <https://semantic-flow.github.io/sflo/config/localPathLocatorKind_workingLocalRelativePath> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop>, <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> ; <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../examples/gunaar.ttl\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> ?file . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> ?page . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#gunaar-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#gunaar-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar/_knop> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../examples/gunaar.ttl\" . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
