{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    },
    "ignorePaths": {
      "@container": "@list"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:bp-01-source-only",
  "dcterms:title": "Fantasy Rules Branch-Published 01 source only",
  "dcterms:description": "Checks the first branch-published source-only proof ref. The source branch contains authored ontology, SHACL, example data, and attribution files, and carries no generated mesh or publication output.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#source-only",
      "dcterms:title": "Seed clean authored source branch",
      "dcterms:description": "Seeds the branch-published source branch from the blank fixture state. Whole-tree completeness should fail if any generated mesh files, docs-rooted sidecar files, or other unexpected paths appear.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "fixture.seed",
      "fromRef": "origin/00-blank-slate",
      "toRef": "bp-01-source-only",
      "hasFileExpectation": [
        {
          "id": "#readme-md",
          "type": "FileExpectation",
          "path": "README.md",
          "changeType": "updated",
          "compareMode": "text"
        },
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#docs-root",
          "type": "FileExpectation",
          "path": "docs",
          "changeType": "absent"
        },
        {
          "id": "#mesh-root",
          "type": "FileExpectation",
          "path": "_mesh",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#ontology-source-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-source-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "id": "#ontology-resource",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology> a <http://www.w3.org/2002/07/owl#Ontology> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "id": "#ability-score-class",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/AbilityScore> a <http://www.w3.org/2002/07/owl#Class> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "id": "#character-class",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/Character> a <http://www.w3.org/2002/07/owl#Class> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#shacl-source-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#shacl-source-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "id": "#shapes-graph",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/shacl> a <http://www.w3.org/ns/shacl#ShapesGraph> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "id": "#character-shape",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/CharacterShape> a <http://www.w3.org/ns/shacl#NodeShape> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#gunaar-source-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#gunaar-source-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "id": "#gunaar-character",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/gunaar> a <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/ontology/PlayerCharacter> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
