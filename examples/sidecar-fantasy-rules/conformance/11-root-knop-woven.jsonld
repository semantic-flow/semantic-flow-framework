  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:11-root-knop-woven",
  "dcterms:title": "Fantasy Rules Sidecar 11 root Knop woven",
  "dcterms:description": "Checks weaving the repository root and examples collection Knops into histories and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-root-and-examples-knops",
      "dcterms:title": "Weave repository root and examples collection Knops",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs and explicit targets for / and examples. The root and examples Knop support artifacts receive first histories and generated pages, while the examples source directory remains ungranted until a concrete examples payload is integrated.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "10-root-knop",
      "toRef": "11-root-knop-woven",
      "targetDesignatorPaths": [
        "/",
        "examples"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/inventory.ttl",
          "changeType": "modified",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state9-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0009/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-state10-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/_history001/_s0010/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-meta-history-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_meta/_history001/_s0001/meta-ttl/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/_history001/_s0001/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-meta-history-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_meta/_history001/_s0001/meta-ttl/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/_history001/_s0001/inventory-ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-page-html",
          "type": "FileExpectation",
          "path": "docs/index.html",
          "changeType": "added"
        },
        {
          "id": "#root-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/_knop/index.html",
          "changeType": "added"
        },
        {
          "id": "#examples-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/index.html",
          "changeType": "added"
        },
        {
          "id": "#examples-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/ontology/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop> <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/semantic-flow-ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#root-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#root-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta> <https://semantic-flow.github.io/semantic-flow-ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta/_history001> ; <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory> <https://semantic-flow.github.io/semantic-flow-ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/_history001> ; <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#examples-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#examples-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta> <https://semantic-flow.github.io/semantic-flow-ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta/_history001> ; <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory> <https://semantic-flow.github.io/semantic-flow-ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/_history001> ; <https://semantic-flow.github.io/semantic-flow-ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/index.html> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
