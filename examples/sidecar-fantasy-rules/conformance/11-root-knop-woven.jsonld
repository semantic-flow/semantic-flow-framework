{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:sidecar-fantasy-rules:11-root-knop-woven",
  "dcterms:title": "Fantasy Rules Sidecar 11 root Knop woven",
  "dcterms:description": "Checks weaving the repository root and examples collection Knops into histories and generated ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-root-and-examples-knops",
      "dcterms:title": "Weave repository root and examples collection Knops",
      "dcterms:description": "Runs weave from the fixture workspace root with mesh root docs and explicit targets for / and examples. The root and examples Knop support artifacts receive first histories and generated pages, while the examples source directory remains ungranted until a concrete examples payload is integrated.",
      "fixtureRepo": "github.com/semantic-flow/mesh-sidecar-fantasy-rules",
      "operationId": "weave",
      "fromRef": "10-root-knop",
      "toRef": "11-root-knop-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": "docs",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "docs",
            "--target",
            "designatorPath=/",
            "--target",
            "designatorPath=examples"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "targetDesignatorPaths": [
        "/",
        "examples"
      ],
      "hasFileExpectation": [
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#shacl-source-ttl",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-source-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-meta-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-inventory-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/_knop/_inventory/_history001/_s0001/ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#examples-inventory-history-ttl",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/_inventory/_history001/_s0001/ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-page-html",
          "type": "FileExpectation",
          "path": "docs/index.html",
          "changeType": "added"
        },
        {
          "id": "#root-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/_knop/index.html",
          "changeType": "added"
        },
        {
          "id": "#examples-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/index.html",
          "changeType": "added"
        },
        {
          "id": "#examples-knop-page-html",
          "type": "FileExpectation",
          "path": "docs/examples/_knop/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?rule <https://semantic-flow.github.io/sflo/config/pathPrefix> \"../examples/\" . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples> <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> ?payload . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#root-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#root-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_meta/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/_history001> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/_knop/_inventory/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#examples-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#examples-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta> <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_meta/index.html> . <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/_history001> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-sidecar-fantasy-rules/examples/_knop/_inventory/index.html> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
