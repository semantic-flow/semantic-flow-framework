  "type": "Manifest",
  "id": "urn:accord:semantic-flow:branch-fantasy-rules:15-extracted-term-references-woven",
  "dcterms:title": "Fantasy Rules Branch-Published 15 extracted term references woven",
      "dcterms:description": "Checks current-only weaving of the curated extracted-term ReferenceCatalogs and their ResourcePages.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-extracted-term-reference-catalogs",
      "dcterms:title": "Weave extracted-term ReferenceCatalogs",
      "dcterms:description": "Runs an explicit targeted weave after curated working-source canonical ReferenceLinks were added for representative extracted terms. The weave adds current ReferenceCatalog pages and advances the owning Knop inventories without materializing support-artifact histories.",
      "fixtureRepo": "github.com/semantic-flow/mesh-branch-fantasy-rules",
      "operationId": "weave",
      "fromRef": "14-extracted-term-references",
      "toRef": "15-extracted-term-references-woven",
      "sourceRef": "10-first-release-source",
      "targetDesignatorPaths": [
        "examples/gunaar/ability-score/strength",
        "ontology/Ability",
        "ontology/CharacterShape"
      ],
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": ".",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--mesh-root",
            "{publicationRoot}",
            "--target",
            "designatorPath=examples/gunaar/ability-score/strength",
            "--target",
            "designatorPath=ontology/Ability",
            "--target",
            "designatorPath=ontology/CharacterShape"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      },
      "hasFileExpectation": [
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-inventory-ttl",
          "type": "FileExpectation",
          "path": "ontology/Ability/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-references-ttl",
          "type": "FileExpectation",
          "path": "ontology/Ability/_knop/_references/references.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ability-references-page",
          "type": "FileExpectation",
          "path": "ontology/Ability/_knop/_references/index.html",
          "changeType": "added"
        },
        {
          "id": "#character-shape-references-ttl",
          "type": "FileExpectation",
          "path": "ontology/CharacterShape/_knop/_references/references.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#character-shape-references-page",
          "type": "FileExpectation",
          "path": "ontology/CharacterShape/_knop/_references/index.html",
          "changeType": "added"
        },
        {
          "id": "#gunaar-strength-references-ttl",
          "type": "FileExpectation",
          "path": "examples/gunaar/ability-score/strength/_knop/_references/references.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#gunaar-strength-references-page",
          "type": "FileExpectation",
          "path": "examples/gunaar/ability-score/strength/_knop/_references/index.html",
          "changeType": "added"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#ability-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ability-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability/_knop> <https://semantic-flow.github.io/sflo/ontology/hasReferenceCatalog> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability/_knop/_references> . <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability/_knop/_references> a <https://semantic-flow.github.io/sflo/ontology/ReferenceCatalog> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability/_knop/_references/index.html> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ability-references-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ability-references-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability/_knop/_references#reference001> a <https://semantic-flow.github.io/sflo/ontology/ReferenceLink> ; <https://semantic-flow.github.io/sflo/ontology/referenceLinkFor> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/Ability> ; <https://semantic-flow.github.io/sflo/ontology/hasReferenceRole> <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ; <https://semantic-flow.github.io/sflo/ontology/referenceTarget> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#character-shape-references-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#character-shape-references-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/CharacterShape/_knop/_references#reference001> a <https://semantic-flow.github.io/sflo/ontology/ReferenceLink> ; <https://semantic-flow.github.io/sflo/ontology/referenceLinkFor> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/CharacterShape> ; <https://semantic-flow.github.io/sflo/ontology/hasReferenceRole> <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ; <https://semantic-flow.github.io/sflo/ontology/referenceTarget> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/shacl> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#gunaar-strength-references-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#gunaar-strength-references-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/examples/gunaar/ability-score/strength/_knop/_references#reference001> a <https://semantic-flow.github.io/sflo/ontology/ReferenceLink> ; <https://semantic-flow.github.io/sflo/ontology/referenceLinkFor> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/examples/gunaar/ability-score/strength> ; <https://semantic-flow.github.io/sflo/ontology/hasReferenceRole> <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ; <https://semantic-flow.github.io/sflo/ontology/referenceTarget> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/examples/gunaar> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
