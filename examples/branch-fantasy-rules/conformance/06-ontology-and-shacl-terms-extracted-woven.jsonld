  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-ontology-and-shacl-terms",
      "dcterms:title": "Weave selected extracted ontology and SHACL terms",
      "dcterms:description": "Runs weave directly against the GitHub Pages publication root with explicit targets for the selected extracted term designator paths. The term support artifacts receive first histories, the mesh inventory records generated pages, and source RDF plus repository-source registries remain unchanged.",
