  "type": "Manifest",
  "id": "urn:accord:semantic-flow:branch-fantasy-rules:03-ontology-integrated-woven",
  "dcterms:title": "Fantasy Rules Branch-Published 03 ontology integrated woven",
  "dcterms:description": "Checks the first floating working-source integration into the branch-published publication root. The ontology source remains in the clean source ref, is integrated as the ontology designator, and is woven in the publication tree.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#ontology-integrated-woven",
      "dcterms:title": "Materialize, integrate, and weave ontology source",
      "dcterms:description": "Runs integrate with an inferred working-only ontology source binding, then weaves the ontology target. The source checkout remains clean; the publication checkpoint gains Knop source registry metadata, ontology Knop support files, and ontology ResourcePages.",
      "fixtureRepo": "github.com/semantic-flow/mesh-branch-fantasy-rules",
      "operationId": "publication.sequence",
      "fromRef": "02-publication-bootstrapped-woven",
      "toRef": "03-ontology-integrated-woven",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "meshRoot": ".",
        "hasCommandSequence": [
          {
            "type": "CommandInvocation",
            "executable": "weave",
            "argv": [
              "integrate",
              "{sourceRoot}/ontology/fantasy-rules-ontology.ttl",
              "ontology",
              "--mesh-root",
              "{publicationRoot}",
              "--grant-source-directory",
              "{sourceRoot}"
            ],
            "workingDirectory": "workspace",
            "promptPolicy": "nonInteractive",
            "expectedExitCode": 0,
            "expectsOperationalLogs": true,
            "expectsAuditLogs": true
          },
          {
            "type": "CommandInvocation",
            "executable": "weave",
            "argv": [
              "--mesh-root",
              "{publicationRoot}",
              "--target",
              "designatorPath=ontology"
            ],
            "workingDirectory": "workspace",
            "promptPolicy": "nonInteractive",
            "expectedExitCode": 0,
            "expectsOperationalLogs": true,
            "expectsAuditLogs": true
          }
        ]
      },
      "hasFileExpectation": [
        {
          "id": "#nojekyll",
          "type": "FileExpectation",
          "path": ".nojekyll",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#mesh-meta-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_meta/meta.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-config-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_config/config.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-source-ttl",
          "type": "FileExpectation",
          "path": "ontology/fantasy-rules-ontology.ttl",
          "changeType": "absent"
        },
        {
          "id": "#ontology-knop-meta-ttl",
          "type": "FileExpectation",
          "path": "ontology/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "ontology/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-sources-ttl",
          "type": "FileExpectation",
          "path": "ontology/_knop/_sources/sources.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-snapshot-ttl",
          "type": "FileExpectation",
          "path": "ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#ontology-page-html",
          "type": "FileExpectation",
          "path": "ontology/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-knop-page-html",
          "type": "FileExpectation",
          "path": "ontology/_knop/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-knop-meta-page-html",
          "type": "FileExpectation",
          "path": "ontology/_knop/_meta/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-knop-inventory-page-html",
          "type": "FileExpectation",
          "path": "ontology/_knop/_inventory/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-history-page-html",
          "type": "FileExpectation",
          "path": "ontology/_history001/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-state-page-html",
          "type": "FileExpectation",
          "path": "ontology/_history001/_s0001/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#ontology-manifestation-page-html",
          "type": "FileExpectation",
          "path": "ontology/_history001/_s0001/ttl/index.html",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#notice-md",
          "type": "FileExpectation",
          "path": "NOTICE.md",
          "changeType": "absent"
        },
        {
          "id": "#shacl-source",
          "type": "FileExpectation",
          "path": "shacl/fantasy-rules-shacl.ttl",
          "changeType": "absent"
        },
        {
          "id": "#gunaar-source",
          "type": "FileExpectation",
          "path": "examples/gunaar.ttl",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#mesh-config-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-config-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?binding <https://semantic-flow.github.io/sflo/ontology/hasTargetRepositorySource> ?source . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config <https://semantic-flow.github.io/sflo/config/workspaceRootRelativeToMeshRoot> ?relativePath . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?config <https://semantic-flow.github.io/sflo/config/hasLocalPathAccessRule> ?rule . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?artifact <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> ?path . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop> . <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> ; <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"../source/ontology/fantasy-rules-ontology.ttl\" ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/index.html> . FILTER NOT EXISTS { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> ?file } }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ontology-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop> a <https://semantic-flow.github.io/sflo/ontology/Knop> ; <https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> ; <https://semantic-flow.github.io/sflo/ontology/hasKnopSourceRegistry> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/index.html> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001> . <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001/_s0001> . <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001/_s0001> <https://semantic-flow.github.io/sflo/ontology/locatedFileForState> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001/_s0001/ttl> a <https://semantic-flow.github.io/sflo/ontology/ArtifactManifestation> ; <https://semantic-flow.github.io/sflo/ontology/hasLocatedFile> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#ontology-sources-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#ontology-sources-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources> a <https://semantic-flow.github.io/sflo/ontology/KnopSourceRegistry> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources/sources.ttl> ; <https://semantic-flow.github.io/sflo/ontology/hasSourceBinding> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources#payload-source> . <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources#payload-source> a <https://semantic-flow.github.io/sflo/ontology/ArtifactResolutionTarget> ; <https://semantic-flow.github.io/sflo/ontology/hasTargetArtifact> <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology> ; <https://semantic-flow.github.io/sflo/ontology/targetLocalRelativePath> \"../source/ontology/fantasy-rules-ontology.ttl\" ; <https://semantic-flow.github.io/sflo/ontology/hasArtifactResolutionMode> <https://semantic-flow.github.io/sflo/ontology/artifactResolutionMode_working> . FILTER NOT EXISTS { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources#payload-source> <https://semantic-flow.github.io/sflo/ontology/expectsContentDigest> ?digest } FILTER NOT EXISTS { <https://semantic-flow.github.io/mesh-branch-fantasy-rules/ontology/_knop/_sources#payload-source> <https://semantic-flow.github.io/sflo/ontology/hasTargetRepositorySource> ?source } }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
