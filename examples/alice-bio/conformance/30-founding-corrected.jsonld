  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:30-founding-corrected",
  "dcterms:title": "Alice Bio 30 founding referent data corrected",
  "dcterms:description": "Checks atomic working-data correction plus immutable state 2 while preserving state 1 exactly.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#founding-corrected",
      "dcterms:title": "Correct settled founding referent data",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "version.foundingReferentData",
      "fromRef": "29-founding-versioned",
      "toRef": "30-founding-corrected",
      "targetDesignatorPath": "founding-demo",
      "ignorePaths": [
        ".accord/**"
      ],
      "hasFileExpectation": [
        {
          "id": "#knop-inventory",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#founding-working",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/data.ttl",
          "changeType": "updated",
          "compareMode": "bytes"
        },
        {
          "id": "#state-1-snapshot",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/_history001/_s0001/ttl/data.ttl",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#state-2-snapshot",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/_history001/_s0002/ttl/data.ttl",
          "changeType": "added",
          "compareMode": "bytes"
        },
        {
          "id": "#founding-page",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#corrected-founding-state",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#knop-inventory",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001> <https://semantic-flow.github.io/sflo/ontology/hasHistoricalState> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0001>, <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0002> ; <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0002> . <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0002> <https://semantic-flow.github.io/sflo/ontology/previousHistoricalState> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0001> ; <https://semantic-flow.github.io/sflo/ontology/hasManifestation> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0002/ttl> . <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0001/ttl> <https://semantic-flow.github.io/sflo/ontology/hasContentDigest> \"sha256:553bf2a95aecf2df236f1fac007a2d096eb543ad6b8157167e779282fd0e6e37\" . <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/_history001/_s0002/ttl> <https://semantic-flow.github.io/sflo/ontology/hasContentDigest> \"sha256:7be783a3110f64c63e133a4fcf6445cce6321a7083e644202c676587adecb724\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { ?founding a <https://semantic-flow.github.io/sflo/ontology/FoundingReferentData> ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePage> ?page . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/data.ttl> <https://semantic-flow.github.io/sflo/ontology/hasContentDigest> ?digest . }",
              "expectedBoolean": false
            }
          ]
        }
      ],
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": ["version", "founding-demo", "--artifact-role", "founding-referent-data", "--source", ".accord/founding-v2.ttl"],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        },
        "hasInputMaterialization": [
          {
            "type": "InputMaterialization",
            "targetPath": ".accord/founding-v2.ttl",
            "hasSourceProvenance": {
              "type": "SourceProvenance",
              "sourceKind": "inlineSource",
              "inlineValue": "@prefix stage: <https://stagecraft.example/vocab/> .\n\n<https://semantic-flow.github.io/mesh-alice-bio/founding-demo>\n  stage:incarnationOf <https://original.example/items/42> ;\n  stage:owner <https://stagecraft.example/waystation/campaigns/example> .\n",
              "mediaType": "text/turtle",
