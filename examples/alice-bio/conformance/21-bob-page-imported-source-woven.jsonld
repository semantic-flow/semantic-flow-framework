{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    },
    "ignorePredicate": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:21-bob-page-imported-source-woven",
  "dcterms:title": "Alice Bio 21 bob bio imported source woven",
  "dcterms:description": "Checks the first weave over Bob's imported biography payload, including Bob bio payload history, generated bob/bio pages, and a refreshed generated bob/ identifier page.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-bob-bio",
      "dcterms:title": "Weave Bob biography payload",
      "dcterms:description": "Versions the imported bob/bio Markdown payload into its first historical state, generates bob/bio ResourcePages, and refreshes bob/index.html without introducing a custom Bob page definition.",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "weave",
      "fromRef": "20-bob-page-imported-source",
      "toRef": "21-bob-page-imported-source-woven",
      "targetDesignatorPath": "bob/bio",
      "hasFileExpectation": [
        {
          "id": "#bob-bio-md",
          "type": "FileExpectation",
          "path": "bob/bio/bob-bio.md",
          "changeType": "unchanged",
          "compareMode": "text"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-bio-page",
          "type": "FileExpectation",
          "path": "bob/bio/index.html",
          "changeType": "added"
        },
        {
          "id": "#bob-bio-history-page",
          "type": "FileExpectation",
          "path": "bob/bio/_history001/index.html",
          "changeType": "added"
        },
        {
          "id": "#bob-bio-state-page",
          "type": "FileExpectation",
          "path": "bob/bio/_history001/_s0001/index.html",
          "changeType": "added"
        },
        {
          "id": "#bob-bio-manifestation-page",
          "type": "FileExpectation",
          "path": "bob/bio/_history001/_s0001/md/index.html",
          "changeType": "added"
        },
        {
          "id": "#bob-bio-snapshot-md",
          "type": "FileExpectation",
          "path": "bob/bio/_history001/_s0001/md/bob-bio.md",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#bob-bio-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "bob/bio/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-bio-knop-inventory-s1-ttl",
          "type": "FileExpectation",
          "path": "bob/bio/_knop/_inventory/_history001/_s0001/ttl/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-page",
          "type": "FileExpectation",
          "path": "bob/index.html",
          "changeType": "updated"
        },
        {
          "id": "#bob-page-main-md",
          "type": "FileExpectation",
          "path": "bob-page-main.md",
          "changeType": "absent"
        },
        {
          "id": "#bob-knop-page-definition-ttl",
          "type": "FileExpectation",
          "path": "bob/_knop/_page/page.ttl",
          "changeType": "absent"
        },
        {
          "id": "#bob-page-main-page",
          "type": "FileExpectation",
          "path": "bob/page-main/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#bob-bio-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#bob-bio-knop-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/bio> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact> ; <https://semantic-flow.github.io/sflo/ontology/currentArtifactHistory> <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/_history001> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/_history001/_s0001> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePageDefinition> ?pageDefinition . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/page-main> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact> . }",
              "expectedBoolean": false
            }
          ]
        }
      ],
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "--history-tracking-policy",
            "versioned",
            "--target",
            "designatorPath=bob/bio"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      }
    }
  ]
}
