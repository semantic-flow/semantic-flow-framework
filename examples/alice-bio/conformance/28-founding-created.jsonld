{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": { "@type": "@vocab" },
    "compareMode": { "@type": "@vocab" },
    "promptPolicy": { "@type": "@vocab" },
    "sourceKind": { "@type": "@vocab" },
    "targetsFileExpectation": { "@type": "@id" }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:28-founding-created",
  "dcterms:title": "Alice Bio 28 founding referent data created",
  "dcterms:description": "Checks optional founding-data initialization with exact working bytes and no history, page, payload, reference, source, or network behavior.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#founding-created",
      "dcterms:title": "Create a Knop with founding referent data",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "knop.create",
      "fromRef": "27-carol-woven",
      "toRef": "28-founding-created",
      "targetDesignatorPath": "founding-demo",
      "ignorePaths": [
        ".accord/**"
      ],
      "hasFileExpectation": [
        {
          "id": "#mesh-inventory",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#knop-meta",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_meta/meta.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#knop-inventory",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#founding-working",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/data.ttl",
          "changeType": "added",
          "compareMode": "bytes"
        },
        {
          "id": "#founding-page",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/index.html",
          "changeType": "absent"
        },
        {
          "id": "#founding-history",
          "type": "FileExpectation",
          "path": "founding-demo/_knop/_founding/_history001/_s0001/ttl/data.ttl",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#knop-meta-machinery-only",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#knop-meta",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo> ?predicate ?object . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#founding-discovery",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#knop-inventory",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop> <https://semantic-flow.github.io/sflo/ontology/hasFoundingReferentData> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding> . <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding> a <https://semantic-flow.github.io/sflo/ontology/FoundingReferentData>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/data.ttl> . <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/data.ttl> a <https://semantic-flow.github.io/sflo/ontology/LocatedFile>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory>|<https://semantic-flow.github.io/sflo/ontology/hasResourcePage>|<https://semantic-flow.github.io/sflo/ontology/hasContentDigest> ?value . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop/_founding/data.ttl> <https://semantic-flow.github.io/sflo/ontology/hasContentDigest> ?digest . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/founding-demo/_knop> ?slot ?value . FILTER(?slot IN (<https://semantic-flow.github.io/sflo/ontology/hasPayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/hasReferenceCatalog>, <https://semantic-flow.github.io/sflo/ontology/hasKnopSourceRegistry>)) }",
              "expectedBoolean": false
            }
          ]
        }
      ],
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": ["knop", "create", "founding-demo", "--founding-data", ".accord/founding-v1.ttl"],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        },
        "hasInputMaterialization": [
          {
            "type": "InputMaterialization",
            "targetPath": ".accord/founding-v1.ttl",
            "hasSourceProvenance": {
              "type": "SourceProvenance",
              "sourceKind": "inlineSource",
              "inlineValue": "@prefix stage: <https://stagecraft.example/vocab/> .\n\n<https://semantic-flow.github.io/mesh-alice-bio/founding-demo>\n  stage:incarnationOf <https://original.example/items/42> .\n",
              "mediaType": "text/turtle",
              "contentDigest": "sha256:553bf2a95aecf2df236f1fac007a2d096eb543ad6b8157167e779282fd0e6e37"
            }
          }
        ]
      }
    }
  ]
}
