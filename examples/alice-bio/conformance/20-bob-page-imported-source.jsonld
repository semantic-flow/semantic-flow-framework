{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    },
    "ignorePredicate": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:20-bob-page-imported-source",
  "dcterms:title": "Alice Bio 20 bob page imported source",
  "dcterms:description": "Checks the non-woven import-boundary step that imports outside-origin Bob Newhart Markdown into local source bytes and adds Bob page-definition state that points at those deterministic local bytes rather than the live URL.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#import-bob-page-main-and-define-bob-page",
      "dcterms:title": "Import Bob Markdown page content and define Bob page source",
      "dcterms:description": "Imports outside-origin Markdown from the raw GitHub URL into local working file bob-page-main.md, adds bob/_knop/_page/page.ttl that points its main region at that local file, and leaves bob/index.html unchanged until weave runs.",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "import",
      "fromRef": "19-alice-page-artifact-source-woven",
      "toRef": "20-bob-page-imported-source",
      "targetDesignatorPath": "bob",
      "hasFileExpectation": [
        {
          "id": "#bob-page-main-md",
          "type": "FileExpectation",
          "path": "bob-page-main.md",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-page-main-knop-meta-ttl",
          "type": "FileExpectation",
          "path": "bob/page-main/_knop/_meta/meta.ttl",
          "changeType": "absent",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-page-main-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "bob/page-main/_knop/_inventory/inventory.ttl",
          "changeType": "absent",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-knop-page-definition-ttl",
          "type": "FileExpectation",
          "path": "bob/_knop/_page/page.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "bob/_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-ttl",
          "type": "FileExpectation",
          "path": "bob/_knop/_references/references.ttl",
          "changeType": "absent",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-page",
          "type": "FileExpectation",
          "path": "bob/index.html",
          "changeType": "unchanged"
        },
        {
          "id": "#bob-page-main-page",
          "type": "FileExpectation",
          "path": "bob/page-main/index.html",
          "changeType": "absent"
        },
        {
          "id": "#bob-knop-page-definition-page",
          "type": "FileExpectation",
          "path": "bob/_knop/_page/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#bob-knop-page-definition-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#bob-knop-page-definition-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageDefinition> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page#main-region> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageRegion> ; <https://semantic-flow.github.io/sflo/ontology/regionKey> \"main\" ; <https://semantic-flow.github.io/sflo/ontology/hasResourcePageSource> <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page#main-source> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page#main-source> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageSource> ; <https://semantic-flow.github.io/sflo/ontology/targetLocalRelativePath> \"bob-page-main.md\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page#main-source> <https://semantic-flow.github.io/sflo/ontology/targetAccessUrl> ?url . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-alice-bio/bob/page-main/_knop> . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/page-main> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact> . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/page-main> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> ?history . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#bob-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#bob-knop-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePageDefinition> <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_page> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_inventory/_history001> <https://semantic-flow.github.io/sflo/ontology/latestHistoricalState> <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop/_inventory/_history001/_s0001> . }",
              "expectedBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
