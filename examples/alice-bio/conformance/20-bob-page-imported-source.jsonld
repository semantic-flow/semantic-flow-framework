{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    },
    "ignorePredicate": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:20-bob-page-imported-source",
  "dcterms:title": "Alice Bio 20 bob bio imported source",
  "dcterms:description": "Checks the non-woven import-boundary step that imports outside-origin Bob Newhart Markdown into a governed bob/bio payload while leaving bob/ as a generated identifier page.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#import-bob-bio",
      "dcterms:title": "Import Bob biography Markdown",
      "dcterms:description": "Imports outside-origin Markdown from the pinned raw GitHub URL into local working file bob/bio/bob-bio.md, creates the bob/bio payload support surface, and does not create a custom Bob ResourcePageDefinition.",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "import",
      "fromRef": "19-favicon-woven",
      "toRef": "20-bob-page-imported-source",
      "targetDesignatorPath": "bob/bio",
      "hasFileExpectation": [
        {
          "id": "#bob-bio-md",
          "type": "FileExpectation",
          "path": "bob/bio/bob-bio.md",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-bio-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "bob/bio/_knop/_inventory/inventory.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bob-page-main-md",
          "type": "FileExpectation",
          "path": "bob-page-main.md",
          "changeType": "absent"
        },
        {
          "id": "#bob-knop-page-definition-ttl",
          "type": "FileExpectation",
          "path": "bob/_knop/_page/page.ttl",
          "changeType": "absent"
        },
        {
          "id": "#bob-page",
          "type": "FileExpectation",
          "path": "bob/index.html",
          "changeType": "unchanged"
        },
        {
          "id": "#bob-bio-page",
          "type": "FileExpectation",
          "path": "bob/bio/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#bob-bio-non-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#bob-bio-knop-inventory-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/bio> a <https://semantic-flow.github.io/sflo/ontology/PayloadArtifact>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact> ; <https://semantic-flow.github.io/sflo/ontology/hasWorkingLocatedFile> <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/bob-bio.md> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/bio> a <https://semantic-flow.github.io/sflo/ontology/RdfDocument> . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/bob-bio.md> a <https://semantic-flow.github.io/sflo/ontology/RdfDocument> . }",
              "expectedBoolean": false
            }
          ]
        },
        {
          "id": "#mesh-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#mesh-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-alice-bio/bob/bio/_knop> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_mesh> <https://semantic-flow.github.io/sflo/ontology/hasKnop> <https://semantic-flow.github.io/mesh-alice-bio/bob/page-main/_knop> . }",
              "expectedBoolean": false
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/bob/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePageDefinition> ?pageDefinition . }",
              "expectedBoolean": false
            }
          ]
        }
      ],
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "hasCommandInvocation": {
          "type": "CommandInvocation",
          "executable": "weave",
          "argv": [
            "import",
            "https://raw.githubusercontent.com/djradon/public-notes/db9a48933f0e6b208baeab7190cef75d1194634f/user.bob-newhart.md",
            "bob/bio",
            "--working-file",
            "bob/bio/bob-bio.md",
            "--expected-digest",
            "sha256:bb2825f0cca2a6075315e93c4ced80abbbb4d072aa8756b8c38d44230a33b5cc"
          ],
          "workingDirectory": "workspace",
          "promptPolicy": "nonInteractive",
          "expectedExitCode": 0,
          "expectsOperationalLogs": true,
          "expectsAuditLogs": true
        }
      }
    }
  ]
}
