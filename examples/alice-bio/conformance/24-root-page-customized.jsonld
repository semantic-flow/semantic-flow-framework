{
  "@context": {
    "@vocab": "https://spectacular-voyage.github.io/accord/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "type": "@type",
    "changeType": {
      "@type": "@vocab"
    },
    "compareMode": {
      "@type": "@vocab"
    },
    "targetsFileExpectation": {
      "@type": "@id"
    },
    "ignorePredicate": {
      "@type": "@id"
    }
  },
  "type": "Manifest",
  "id": "urn:accord:semantic-flow:alice-bio:24-root-page-customized",
  "dcterms:title": "Alice Bio 24 root page customized",
  "dcterms:description": "Checks the non-woven step that adds the root knop-owned page-definition support artifact, mesh-local root page source files, and a root knop-local stylesheet without yet weaving root page-definition histories or replacing the generic root page.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#define-root-page",
      "dcterms:title": "Add root page-definition artifact without weaving",
      "dcterms:description": "Adds _knop/_page/page.ttl, home.md, and _knop/_assets/site.css, reuses the governed sidebar artifact, updates _knop/_inventory to register the new root ResourcePageDefinition and KnopAssetBundle, and leaves index.html unchanged until weave runs.",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "resourcePage.define",
      "fromRef": "23-root-knop-created-woven",
      "toRef": "24-root-page-customized",
      "targetDesignatorPath": "/",
      "hasReplayProfile": {
        "type": "ReplayProfile",
        "workspaceRoot": ".",
        "hasFileOperation": [
          {
            "type": "FileOperation",
            "operationKind": "copyFile",
            "targetPath": "_knop/_page/page.ttl",
            "hasSourceProvenance": {
              "type": "SourceProvenance",
              "sourceKind": "fixtureRefSource",
              "sourcePath": ".assets/24-root-page-customized/_knop/_page/page.ttl",
              "derivationNote": "fixture-authored canonical page definition adapted from the Alice Bio main branch root page bytes",
              "sourceRef": "assets"
            }
          },
          {
            "type": "FileOperation",
            "operationKind": "copyFile",
            "targetPath": "home.md",
            "hasSourceProvenance": {
              "type": "SourceProvenance",
              "sourceKind": "fixtureRefSource",
              "sourcePath": ".assets/24-root-page-customized/home.md",
              "derivationNote": "fixture-authored root Markdown copied from the Alice Bio main branch source bytes",
              "sourceRef": "assets"
            }
          },
          {
            "type": "FileOperation",
            "operationKind": "copyFile",
            "targetPath": "_knop/_assets/site.css",
            "hasSourceProvenance": {
              "type": "SourceProvenance",
              "sourceKind": "fixtureRefSource",
              "sourcePath": ".assets/24-root-page-customized/_knop/_assets/site.css",
              "derivationNote": "fixture-authored root stylesheet copied from the Alice Bio main branch source bytes",
              "sourceRef": "assets"
            }
          }
        ]
      },
      "hasFileExpectation": [
        {
          "id": "#root-home-md",
          "type": "FileExpectation",
          "path": "home.md",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#root-knop-asset-css",
          "type": "FileExpectation",
          "path": "_knop/_assets/site.css",
          "changeType": "added",
          "compareMode": "text"
        },
        {
          "id": "#root-knop-page-definition-ttl",
          "type": "FileExpectation",
          "path": "_knop/_page/page.ttl",
          "changeType": "added",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-knop-inventory-ttl",
          "type": "FileExpectation",
          "path": "_knop/_inventory/inventory.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#mesh-inventory-ttl",
          "type": "FileExpectation",
          "path": "_mesh/_inventory/inventory.ttl",
          "changeType": "unchanged",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#root-page",
          "type": "FileExpectation",
          "path": "index.html",
          "changeType": "unchanged"
        },
        {
          "id": "#root-knop-page-definition-page",
          "type": "FileExpectation",
          "path": "_knop/_page/index.html",
          "changeType": "absent"
        }
      ],
      "hasRdfExpectation": [
        {
          "id": "#root-knop-page-definition-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#root-knop-page-definition-ttl",
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageDefinition> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page> <https://semantic-flow.github.io/sflo/ontology/hasPageRegion> ?mainRegion, ?sidebarRegion . ?mainRegion <https://semantic-flow.github.io/sflo/ontology/regionKey> \"main\" . ?sidebarRegion <https://semantic-flow.github.io/sflo/ontology/regionKey> \"sidebar\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page#main-source> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageSource> ; <https://semantic-flow.github.io/sflo/ontology/targetLocalRelativePath> \"home.md\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page#sidebar-source> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageSource> ; <https://semantic-flow.github.io/sflo/ontology/targetArtifact> <https://semantic-flow.github.io/mesh-alice-bio/mesh-content/sidebar> ; <https://semantic-flow.github.io/sflo/ontology/hasArtifactResolutionMode> <https://semantic-flow.github.io/sflo/ontology/artifactResolutionMode_working> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#root-knop-inventory-rdf",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#root-knop-inventory-ttl",
          "ignorePredicate": [
            "http://purl.org/dc/terms/created",
            "http://purl.org/dc/terms/updated"
          ],
          "hasAskAssertion": [
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop> <https://semantic-flow.github.io/sflo/ontology/hasResourcePageDefinition> <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page> ; <https://semantic-flow.github.io/sflo/ontology/hasKnopAssetBundle> <https://semantic-flow.github.io/mesh-alice-bio/_knop/_assets> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page> a <https://semantic-flow.github.io/sflo/ontology/ResourcePageDefinition>, <https://semantic-flow.github.io/sflo/ontology/DigitalArtifact>, <https://semantic-flow.github.io/sflo/ontology/RdfDocument> ; <https://semantic-flow.github.io/sflo/ontology/workingLocalRelativePath> \"_knop/_page/page.ttl\" . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_assets> a <https://semantic-flow.github.io/sflo/ontology/KnopAssetBundle> . }",
              "expectedBoolean": true
            },
            {
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://semantic-flow.github.io/mesh-alice-bio/_knop/_page> <https://semantic-flow.github.io/sflo/ontology/hasArtifactHistory> ?history . }",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
}
