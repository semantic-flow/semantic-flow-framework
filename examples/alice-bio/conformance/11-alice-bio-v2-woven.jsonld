  "id": "urn:accord:semantic-flow:alice-bio:11-alice-bio-v2-woven",
  "dcterms:title": "Alice Bio 11 alice bio v2 woven",
  "dcterms:description": "Checks the weave over the updated alice/data payload, including the second payload historical state, the advanced alice/data KnopInventory state, richer linked ResourcePages, and an unchanged mesh inventory.",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#weave-alice-bio-v2",
      "dcterms:title": "Weave second alice/data payload state",
      "dcterms:description": "Versions the updated alice/data payload into _s0002, advances alice/data KnopInventory to a second historical state, regenerates the key public and history-facing ResourcePages with links, and leaves _mesh/_inventory unchanged because the second payload state does not widen mesh inventory.",
      "fixtureRepo": "github.com/semantic-flow/mesh-alice-bio",
      "operationId": "weave",
      "fromRef": "10-alice-bio-updated",
      "toRef": "11-alice-bio-v2-woven",
